# Copy to .env for local runs (`./dev.sh run`). .env is gitignored — never commit real secrets.
# Generate keys with: openssl rand -base64 32
PSYCHOSPACE_ENV=dev
PSYCHOSPACE_HTTP_ADDR=127.0.0.1:8080
PSYCHOSPACE_BASE_URL=http://localhost:8080
PSYCHOSPACE_DATABASE_URL=postgres://psychospace:psychospace@127.0.0.1:5432/psychospace?sslmode=disable

# Optional. LOG_DIR adds a rotated file log next to stdout (prod sets it);
# SESSION_TTL overrides how long a session cookie stays valid (Go duration).
PSYCHOSPACE_LOG_DIR=
PSYCHOSPACE_SESSION_TTL=

PSYCHOSPACE_ENC_KEY=CHANGE_ME_base64_32_bytes
PSYCHOSPACE_HMAC_KEY=CHANGE_ME_base64_32_bytes
PSYCHOSPACE_SESSION_KEY=CHANGE_ME_base64_32_bytes

# VK ID (optional until P2). Leave blank to run without auth.
PSYCHOSPACE_VK_APP_ID=54691267
PSYCHOSPACE_VK_SERVICE_TOKEN=
# The URL VK sends the browser back to. It is a PAGE of the SPA, not an API
# endpoint — VK navigates a browser there with GET. Three copies must agree
# exactly or no login works: this one (echoed at the token exchange), the value
# the SPA sends at authorize (web/src/constants.ts VK_REDIRECT_PATH), and the
# redirect URL registered on the VK app.
PSYCHOSPACE_VK_REDIRECT_URI=http://localhost:8080/auth/redirect

# Optional id_token (OIDC) signature verification. Off by default; enable only
# after confirming VK's JWKS URL against the live app (else login is rejected).
PSYCHOSPACE_VK_VERIFY_IDTOKEN=false
PSYCHOSPACE_VK_JWKS_URL=
PSYCHOSPACE_VK_ISSUER=

# Yandex ID — the second login provider. All three or none: half-configured
# fails at startup rather than showing a button that answers 503.
#
# Unlike VK there is no public app id the SPA also needs, because Yandex needs no
# browser SDK: the authorize URL is built on the server, so the client id and
# this redirect URI live only here. Two copies must agree — this one and the
# Redirect URI registered on the Yandex app — instead of VK's three.
#
# Real Yandex login cannot run on a workstation (the registered redirect URI is
# the production domain), so leave these blank locally and use `./dev.sh seed`.
PSYCHOSPACE_YANDEX_CLIENT_ID=
PSYCHOSPACE_YANDEX_CLIENT_SECRET=
PSYCHOSPACE_YANDEX_REDIRECT_URI=http://localhost:8080/auth/yandex/redirect

# Test seams only — two of them because Yandex serves authorize/token from
# oauth.yandex.ru but the profile from login.yandex.ru. Leave unset in
# production; the defaults are the real endpoints.
# PSYCHOSPACE_YANDEX_OAUTH_BASE_URL=https://oauth.yandex.ru
# PSYCHOSPACE_YANDEX_INFO_URL=https://login.yandex.ru/info

# Game AI judge — OpenAI-compatible chat endpoint. Currently DeepSeek V4 Flash
# on Yandex AI Studio. Set all three to enable the game; leave blank and
# /api/game-khimki/attempt returns 503. MODEL is the full model URI (folder-specific);
# `curl -H "Authorization: Bearer $KEY" $BASE/models` lists what is available.
# Get an API key in the Yandex Cloud console. Every turn costs money.
PSYCHOSPACE_LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
PSYCHOSPACE_LLM_API_KEY=
PSYCHOSPACE_LLM_MODEL=gpt://<folder-id>/deepseek-v4-flash/latest

# Tracing export (off by default — trace IDs are still generated). e.g. localhost:4318
PSYCHOSPACE_OTLP_ENDPOINT=
